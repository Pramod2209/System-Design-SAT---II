  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "U101",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "P101",
